<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ring_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="48dp"
    android:paddingEnd="28dp"
    android:paddingBottom="40dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="BANGUN, REY!"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:text="07:00"
        android:textColor="#FFFFFF"
        android:textSize="64sp" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white_70"
        android:textSize="16sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/ring_box"
        android:layout_width="260dp"
        android:layout_height="260dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:max="10"
            android:progress="0"
            app:indicatorColor="#FFFFFF"
            app:indicatorSize="250dp"
            app:trackColor="@color/white_20"
            app:trackCornerRadius="8dp"
            app:trackThickness="14dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/walk_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_walk"
                android:tint="@color/white_70" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="84sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="of 10 steps"
                android:textColor="@color/white_70"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Get out of bed and walk with your phone.\nThe alarm stops when your steps are counted."
        android:textColor="@color/white_70"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emergency"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="No motion sensor found: Stop"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:strokeColor="#FFFFFF" />
</LinearLayout>
